{
  "manifest_version": 3,
  "name": "Chrome Remote Control Bridge",
  "version": "1.0.0",
  "description": "Puente local WebSocket para controlar pestañas, navegación y video HTML5 desde el celular.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "bookmarks",
    "history",
    "downloads",
    "sessions",
    "scripting",
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Chrome Remote Control",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content_media.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
